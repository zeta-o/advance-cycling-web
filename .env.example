# Contact form (Resend: https://resend.com)
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Advance Cycling <contacto@advancetalenthub.com>"
RESEND_FROM=
# Where messages are delivered (defaults to alonzo@advancetalenthub.com)
CONTACT_TO_EMAIL=alonzo@advancetalenthub.com

# Public site URL, used for Open Graph images
NEXT_PUBLIC_SITE_URL=
